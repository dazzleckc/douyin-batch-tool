# 火山引擎 ARK API Key（必填）
# 获取方式：https://console.volcengine.com/ark
ARK_API_KEY=your_api_key_here

# 抖音登录态 Cookie（必填）
# 获取方式：浏览器登录抖音 → F12 → Network → 复制 Cookie
DOUYIN_COOKIE=your_cookie_here

# ARK API 端点（可选，默认值如下）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 ID（可选）
# ARK_MODEL=doubao-seed-1-6-251015

# 输出目录（可选，默认 ./output）
# OUTPUT_DIR=./output
